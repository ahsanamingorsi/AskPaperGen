@{
  Layout = null;
  int    tmplId      = ViewBag.TemplateId     as int?   ?? 0;
  string tmplJson    = ViewBag.TemplateJson   as string ?? "null";
  bool   saveDisabled= (ViewBag.SaveDisabled  as bool?) ?? true;
  string saveMsg     = ViewBag.SaveDisabledMsg as string ?? "Saving is disabled due to security concerns.";
}
<!DOCTYPE html>
<html lang="en" class="gp">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Paper Generator — AskPaperGen</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Noto+Nastaliq+Urdu:wght@400;600;700&display=swap" rel="stylesheet"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
<link rel="stylesheet" href="~/css/apg.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/generator.css" asp-append-version="true"/>
    <style>        html.gp, body.gp {
                height: auto;
                overflow-x: hidden;
                overflow-y: auto; /* ✅ allow full scroll */
        }</style>
</head>

<body class="gp">

<!-- ═══ TOP BAR ═══════════════════════════════════════════════ -->
<div class="gen-bar">
  <button class="btn-icon" id="nav-toggle" style="flex-shrink:0;display:none" title="Sections">
    <i class="bi bi-list-ul"></i>
  </button>
  <a href="/Dashboard" class="btn-icon" style="flex-shrink:0" title="Dashboard">
    <i class="bi bi-arrow-left"></i>
  </a>
  <input type="text" id="gen-title-input" class="gen-title"
         placeholder="Paper title — e.g. Mid-Term Physics 2025" autocomplete="off"/>
  <div class="gen-bar-right">
    <button class="btn btn-ghost btn-sm" id="prev-toggle" style="display:none" title="Preview">
      <i class="bi bi-eye"></i>
    </button>
    <button class="btn btn-ghost btn-sm" id="btn-tmpl" title="Templates">
      <i class="bi bi-grid-1x2"></i>
      <span style="margin-left:4px;display:none" class="sm-lbl">Templates</span>
    </button>
    <button class="btn btn-ghost btn-sm" id="btn-json" title="Export JSON">
      <i class="bi bi-download"></i>
    </button>
    <button class="btn btn-success btn-sm" id="btn-pdf">
      <i class="bi bi-filetype-pdf"></i>
      <span style="margin-left:4px">PDF</span>
    </button>
  </div>
</div>

@if (saveDisabled) {
  <div class="save-notice-bar" id="save-notice-bar">
    <i class="bi bi-shield-exclamation"></i>
    <span>@saveMsg</span>
  </div>
}

<!-- ═══ 3-PANEL LAYOUT ════════════════════════════════════════ -->
<div class="gen-layout" id="gen-layout">

  <!-- ── PANEL 1: Navigation Sidebar ── -->
  <aside class="gen-nav" id="gen-nav">
    <div class="gen-nav-hd">
      <span class="gen-nav-title">Paper Outline</span>
      <button class="btn btn-primary btn-xs" onclick="G.openAddSection()">
        <i class="bi bi-plus-lg"></i> Section
      </button>
    </div>
    <div class="gen-nav-body" id="nav-outline">
      <div style="color:var(--ink4);font-size:.8rem;text-align:center;padding:20px 8px">
        <i class="bi bi-layout-text-sidebar" style="font-size:1.5rem;display:block;margin-bottom:6px;opacity:.4"></i>
        No sections yet
      </div>
    </div>
    <div class="nav-tools">
      <button class="nav-tool" id="btn-print">
        <i class="bi bi-printer"></i> Print
      </button>
      <button class="nav-tool" onclick="G.openTmplModal()">
        <i class="bi bi-layout-text-window"></i> Templates
      </button>
      <button class="nav-tool" onclick="G.exportJson()">
        <i class="bi bi-download"></i> Export JSON
      </button>
    </div>
  </aside>

  <!-- ── PANEL 2: Builder ── -->
  <div class="gen-builder" id="gen-builder">

    <!-- 1. Institute Info -->
    <div class="gc" id="card-info">
      <div class="gc-hd" onclick="G.toggleCard(this)">
        <div class="gc-hd-left">
          <div class="gc-hd-ic ci-blue"><i class="bi bi-building"></i></div>
          <span class="gc-title">Institute Information</span>
        </div>
        <i class="bi bi-chevron-down gc-chev"></i>
      </div>
      <div class="gc-body">
        <div style="margin-bottom:14px">
          <label class="label">Institute Logo <span style="color:var(--ink4)">(optional)</span></label>
          <div class="logo-drop" id="logo-drop">
            <input type="file" accept="image/*" id="logo-input"/>
            <div id="logo-ph" style="display:flex;align-items:center;gap:7px;color:var(--ink4)">
              <i class="bi bi-building" style="font-size:1.2rem"></i>
              <small>Click to upload logo</small>
            </div>
            <img id="logo-prev" class="logo-prev" style="display:none" alt="Logo"/>
            <button type="button" id="logo-rm" style="display:none;position:absolute;top:4px;right:4px"
                    class="btn-icon danger btn-xs" onclick="G.removeLogo(event)">
              <i class="bi bi-x"></i>
            </button>
          </div>
        </div>
        <div class="form-grid g2" style="margin-bottom:12px">
          <div><label class="label">Institute Name</label><input type="text" id="f_institute" class="input ff" placeholder="University of Technology"/></div>
          <div><label class="label">Affiliation</label><input type="text" id="f_affil" class="input ff" placeholder="Affiliated with HEC"/></div>
        </div>
        <div class="form-grid g2" style="margin-bottom:12px">
          <div><label class="label">Department</label><input type="text" id="f_dept" class="input ff" placeholder="Computer Science"/></div>
          <div><label class="label">Course / Program</label><input type="text" id="f_course" class="input ff" placeholder="BS Computer Science"/></div>
        </div>
        <div class="form-grid g2">
          <div><label class="label">Instructor Name</label><input type="text" id="f_instr" class="input ff" placeholder="Prof. Dr. Ali Khan"/></div>
          <div><label class="label">Paper Code</label><input type="text" id="f_code" class="input ff" placeholder="CS-301"/></div>
        </div>
      </div>
    </div>

    <!-- 2. Paper Configuration -->
    <div class="gc" id="card-config">
      <div class="gc-hd" onclick="G.toggleCard(this)">
        <div class="gc-hd-left">
          <div class="gc-hd-ic ci-purple"><i class="bi bi-clipboard-data"></i></div>
          <span class="gc-title">Paper Configuration</span>
        </div>
        <i class="bi bi-chevron-down gc-chev"></i>
      </div>
      <div class="gc-body">
        <div class="form-grid g2" style="margin-bottom:12px">
          <div><label class="label">Subject *</label><input type="text" id="f_subject" class="input ff" placeholder="Data Structures"/></div>
          <div><label class="label">Subject Code</label><input type="text" id="f_subcode" class="input ff" placeholder="CS-202"/></div>
        </div>
        <div class="form-grid g3" style="margin-bottom:12px">
          <div>
            <label class="label">Exam Type</label>
            <select id="f_examtype" class="select ff">
              <option value="">Select…</option>
              @foreach (var et in new[]{"Mid-Term","Final Term","Quiz","Assignment","Sessional","Annual","Lab Exam","Test"})
              { <option>@et</option> }
            </select>
          </div>
          <div><label class="label">Total Marks</label><input type="number" id="f_marks" class="input ff" placeholder="100" min="0"/></div>
          <div><label class="label">Duration</label><input type="text" id="f_dur" class="input ff" placeholder="3 Hours"/></div>
        </div>
        <div class="form-grid g3" style="margin-bottom:12px">
          <div><label class="label">Grade / Class</label><input type="text" id="f_grade" class="input ff" placeholder="Grade 11"/></div>
          <div><label class="label">Date</label><input type="date" id="f_date" class="input ff"/></div>
          <div><label class="label">Academic Year</label><input type="text" id="f_year" class="input ff" placeholder="2024–25"/></div>
        </div>
        <div class="form-grid g2">
          <div>
            <label class="label">Language</label>
            <select id="f_lang" class="select">
              <option value="English">English (LTR)</option>
              <option value="Urdu">Urdu (RTL)</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Design -->
    <div class="gc" id="card-design">
      <div class="gc-hd" onclick="G.toggleCard(this)">
        <div class="gc-hd-left">
          <div class="gc-hd-ic ci-amber"><i class="bi bi-palette"></i></div>
          <span class="gc-title">Paper Design</span>
        </div>
        <i class="bi bi-chevron-down gc-chev"></i>
      </div>
      <div class="gc-body">
        <div class="form-grid g2" style="margin-bottom:14px">
          <div>
            <label class="label">Primary Color</label>
            <div class="swatch-row" id="swatches">
              @foreach (var c in new[]{"#1e3a8a","#2563eb","#0f766e","#166534","#7c3aed","#9a3412","#8b0000","#0f172a","#0369a1","#b45309","#be123c","#374151"})
              { <span class="swatch" style="background:@c" data-c="@c" title="@c"></span> }
            </div>
            <input type="color" id="f_color" class="input" value="#1e3a8a"
                   style="height:34px;padding:2px 6px;cursor:pointer;margin-top:8px;width:100%"/>
          </div>
          <div>
            <label class="label">Header Style</label>
            <select id="f_hstyle" class="select ff" style="margin-bottom:8px">
              <option value="band">Color Band</option>
              <option value="line">Double Line</option>
              <option value="minimal">Minimal</option>
              <option value="box">Box Border</option>
            </select>
            <label class="label">Section Style</label>
            <select id="f_sstyle" class="select ff">
              <option value="sidebar">Side Bar</option>
              <option value="underline">Underline</option>
              <option value="band">Band</option>
              <option value="box">Box</option>
            </select>
          </div>
        </div>
        <div class="form-grid g3" style="margin-bottom:14px">
          <div>
            <label class="label">Font Family</label>
            <select id="f_font" class="select ff">
              <option value="times">Times New Roman</option>
              <option value="arial">Arial</option>
              <option value="calibri">Calibri</option>
              <option value="urdu">Urdu Nastaliq</option>
            </select>
          </div>
          <div>
            <label class="label">Font Size</label>
            <select id="f_fsize" class="select ff">
              <option value="10">10pt</option>
              <option value="11" selected>11pt</option>
              <option value="12">12pt</option>
            </select>
          </div>
          <div>
            <label class="label">Paper Size</label>
            <select id="f_psize" class="select ff">
              <option value="A4">A4</option>
              <option value="Letter">Letter</option>
              <option value="Legal">Legal</option>
            </select>
          </div>
        </div>
        <div style="border:1px solid var(--border);border-radius:var(--r);padding:4px 12px">
          <div class="toggle-row">
            <span class="toggle-row-label">Show answer lines</span>
            <label class="toggle"><input type="checkbox" id="d_anslines" class="toggle-ff" checked/><div class="toggle-track"></div></label>
          </div>
          <div class="toggle-row">
            <span class="toggle-row-label">Show marks column</span>
            <label class="toggle"><input type="checkbox" id="d_marks" class="toggle-ff" checked/><div class="toggle-track"></div></label>
          </div>
          <div class="toggle-row">
            <span class="toggle-row-label">Show general instructions</span>
            <label class="toggle"><input type="checkbox" id="d_showinstr" class="toggle-ff" checked/><div class="toggle-track"></div></label>
          </div>
          <div class="toggle-row">
            <span class="toggle-row-label">Show page numbers</span>
            <label class="toggle"><input type="checkbox" id="d_pagenums" class="toggle-ff" checked/><div class="toggle-track"></div></label>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Instructions -->
    <div class="gc" id="card-instrs">
      <div class="gc-hd" onclick="G.toggleCard(this)">
        <div class="gc-hd-left">
          <div class="gc-hd-ic ci-green"><i class="bi bi-list-check"></i></div>
          <span class="gc-title">General Instructions</span>
        </div>
        <i class="bi bi-chevron-down gc-chev"></i>
      </div>
      <div class="gc-body">
        <div id="instr-list" style="margin-bottom:10px"></div>
        <div style="display:flex;gap:7px">
          <input type="text" id="instr-add" class="input" style="flex:1"
                 placeholder="Type instruction and press Enter…"/>
          <button id="instr-add-btn" class="btn btn-ghost btn-sm" style="flex-shrink:0">
            <i class="bi bi-plus-lg"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- 5. Sections & Questions -->
    <div class="gc" id="card-sections">
      <div class="gc-hd" style="cursor:default">
        <div class="gc-hd-left">
          <div class="gc-hd-ic ci-purple"><i class="bi bi-layout-text-sidebar-reverse"></i></div>
          <span class="gc-title">
            Sections &amp; Questions
            <span class="chip chip-gray" id="sec-count" style="font-size:.68rem;margin-left:6px">0 sections</span>
          </span>
        </div>
        <button class="btn btn-primary btn-sm" onclick="G.openAddSection()">
          <i class="bi bi-plus-lg"></i> Section
        </button>
      </div>
      <div class="gc-body" style="padding:12px">
        <div class="secs-wrap" id="secs-wrap"></div>
        <div id="no-secs" class="empty-sec" style="margin-top:8px">
          <i class="bi bi-layout-text-sidebar" style="font-size:1.8rem;display:block;margin-bottom:6px;opacity:.3"></i>
          No sections yet — click <strong>+ Section</strong> to build your paper.
        </div>
      </div>
    </div>

  </div><!-- /gen-builder -->

  <!-- ── PANEL 3: Preview ── -->
  <div class="gen-preview" id="gen-preview">
    <div class="prev-hd">
      <span class="prev-title"><i class="bi bi-eye" style="margin-right:5px"></i>Live Preview</span>
      <div style="display:flex;gap:6px">
        <button class="btn-icon" onclick="window.print()" title="Print">
          <i class="bi bi-printer"></i>
        </button>
        <button class="btn-icon d-none" id="prev-close" title="Close">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
    </div>
    <div class="prev-wrap">
      <div class="paper-sheet" id="paper-preview"></div>
    </div>
    <div class="exp-panel">
      <div class="exp-title"><i class="bi bi-share" style="margin-right:6px"></i>Export</div>
      <div class="exp-grid">
        <button class="exp-btn p" onclick="G.exportPdf()">
          <div class="ei"><i class="bi bi-filetype-pdf"></i></div>Export PDF
        </button>
        <button class="exp-btn g" onclick="G.exportJson()">
          <div class="ei"><i class="bi bi-filecode"></i></div>JSON File
        </button>
        <button class="exp-btn" onclick="G.openTmplModal()">
          <div class="ei"><i class="bi bi-layout-text-window"></i></div>Save Template
        </button>
        <button class="exp-btn" onclick="window.print()">
          <div class="ei"><i class="bi bi-printer"></i></div>Print
        </button>
      </div>
    </div>
  </div><!-- /gen-preview -->

</div><!-- /gen-layout -->


<!-- ══ SECTION MODAL ══════════════════════════════════════════ -->
<div class="modal-ov" id="sec-modal">
<div class="modal">
  <div class="modal-hd">
    <span class="modal-title" id="sec-modal-title">Add Section</span>
    <button class="btn-icon" onclick="G.closeModal('sec-modal')"><i class="bi bi-x-lg"></i></button>
  </div>
  <div class="modal-body">
    <input type="hidden" id="edit-sec-id"/>
    <div style="margin-bottom:14px">
      <label class="label">Section Title *</label>
      <input type="text" id="secTitle" class="input" placeholder="e.g. Section A – MCQs"/>
    </div>
    <div style="margin-bottom:14px">
      <label class="label">Instructions</label>
      <textarea id="secInstr" class="input textarea" rows="2"
                placeholder="e.g. Choose the correct answer. Each carries 1 mark."></textarea>
    </div>
    <div class="form-grid g2" style="margin-bottom:14px">
      <div><label class="label">Default Marks / Question</label><input type="number" id="secMarks" class="input" value="1" min="0"/></div>
      <div><label class="label">Attempt Rule</label><input type="text" id="secAttempt" class="input" placeholder="Attempt any 5"/></div>
    </div>
    <div>
      <label class="label" style="margin-bottom:8px">Question Type Preset</label>
      <div class="sec-presets">
        <div class="spreset" data-t="mcq"><i class="bi bi-list-ol"></i>MCQ</div>
        <div class="spreset" data-t="short"><i class="bi bi-chat-square-text"></i>Short</div>
        <div class="spreset" data-t="long"><i class="bi bi-file-text"></i>Long</div>
        <div class="spreset on" data-t="mixed"><i class="bi bi-shuffle"></i>Mixed</div>
      </div>
      <input type="hidden" id="secQType" value="mixed"/>
    </div>
  </div>
  <div class="modal-ft">
    <button class="btn btn-ghost btn-sm" onclick="G.closeModal('sec-modal')">Cancel</button>
    <button class="btn btn-primary btn-sm" onclick="G.saveSection()">Save Section</button>
  </div>
</div>
</div>

<!-- ══ QUESTION MODAL ═════════════════════════════════════════ -->
<div class="modal-ov" id="q-modal">
<div class="modal lg">
  <div class="modal-hd">
    <span class="modal-title" id="q-modal-title">Add Question</span>
    <button class="btn-icon" onclick="G.closeModal('q-modal')"><i class="bi bi-x-lg"></i></button>
  </div>
  <div class="modal-body">
    <input type="hidden" id="edit-q-id"/>
    <input type="hidden" id="edit-q-secid"/>
    <div class="form-grid g3" style="margin-bottom:14px">
      <div>
        <label class="label">Question Type *</label>
        <select id="qType" class="select" onchange="G.toggleQFields()">
          <option value="1">Short Question</option>
          <option value="2">Long Question</option>
          <option value="3">MCQ (A–D)</option>
          <option value="5">Fill in the Blank</option>
          <option value="6">True / False</option>
        </select>
      </div>
      <div>
        <label class="label">Marks <small style="color:var(--ink4)">(0 = section default)</small></label>
        <input type="number" id="qMarks" class="input" value="0" min="0"/>
      </div>
      <div>
        <label class="label">Answer Lines <small style="color:var(--ink4)">(blank = auto)</small></label>
        <input type="number" id="qLines" class="input" placeholder="auto" min="1" max="20"/>
      </div>
    </div>
    <div style="margin-bottom:14px">
      <label class="label">Question Text *</label>
      <textarea id="qText" class="input textarea" rows="3" placeholder="Type your question here…"></textarea>
    </div>
    <div style="margin-bottom:14px;display:none" id="urdu-q-field">
      <label class="label">Urdu Translation <span style="color:var(--ink4)">(optional)</span></label>
      <textarea id="qUrdu" class="input textarea" rows="2"
                placeholder="اردو سوال یہاں لکھیں..."
                style="direction:rtl;font-family:'Noto Nastaliq Urdu',serif"></textarea>
    </div>
    <!-- MCQ Options -->
    <div id="mcq-fields" style="display:none;margin-bottom:14px">
      <label class="label">MCQ Options</label>
      <div class="mcq-opts">
        @foreach (var lbl in new[]{"A","B","C","D"}) {
          <div class="mcq-row">
            <div class="opt-letter">@lbl</div>
            <input type="text" id="opt@lbl" class="input" placeholder="Option @lbl"/>
            <input type="radio" name="correct" class="opt-radio" value="@lbl" id="rad@lbl"/>
            <label for="rad@lbl" style="font-size:.75rem;color:var(--green);font-weight:600;white-space:nowrap;cursor:pointer">✓ Correct</label>
          </div>
        }
      </div>
    </div>
    <!-- Image -->
    <div>
      <label class="label">Question Image <span style="color:var(--ink4)">(optional, max 2MB)</span></label>
      <div class="img-attach">
        <input type="file" accept="image/*" id="q-img-input"/>
        <div id="q-img-ph">
          <i class="bi bi-image" style="color:var(--ink4);font-size:1.2rem"></i>
          <small style="color:var(--ink4)"> Click to attach image</small>
        </div>
        <div class="img-prev-wrap" id="q-img-prevwrap" style="display:none">
          <img id="q-img-prev" src="" alt=""/>
          <button type="button" class="img-rm" onclick="G.clearQImg()"><i class="bi bi-x"></i></button>
        </div>
      </div>
      <input type="hidden" id="q-img-b64"/>
      <input type="hidden" id="q-img-mime"/>
    </div>
  </div>
  <div class="modal-ft">
    <button class="btn btn-ghost btn-sm" onclick="G.closeModal('q-modal')">Cancel</button>
    <button class="btn btn-primary btn-sm" onclick="G.saveQuestion()">Save Question</button>
  </div>
</div>
</div>

<!-- ══ TEMPLATE MODAL ════════════════════════════════════════ -->
<div class="modal-ov" id="tmpl-modal">
<div class="modal xl">
  <div class="modal-hd">
    <span class="modal-title"><i class="bi bi-layout-text-window" style="margin-right:8px"></i>Paper Templates</span>
    <button class="btn-icon" onclick="G.closeModal('tmpl-modal')"><i class="bi bi-x-lg"></i></button>
  </div>
  <div class="modal-body">
    <div class="tmpl-tabs">
      <button class="tmpl-tab on" data-p="browse">Browse Templates</button>
      <button class="tmpl-tab" data-p="save">Save as Template</button>
    </div>
    <!-- Browse -->
    <div class="tmpl-pane on" id="tp_browse">
      <p style="font-size:.82rem;color:var(--ink3);margin-bottom:14px">
        Select a template to apply its design, colors, fonts and section structure.
      </p>
      <div id="tmpl-gallery" class="tmpl-gallery">
        <div style="color:var(--ink4);padding:24px;text-align:center">
          <i class="bi bi-arrow-clockwise" style="animation:spin .8s linear infinite;display:inline-block;margin-right:6px"></i>
          Loading templates…
        </div>
      </div>
    </div>
    <!-- Save -->
    <div class="tmpl-pane" id="tp_save">
      <div class="form-grid g2" style="margin-bottom:12px">
        <div><label class="label">Template Name *</label><input type="text" id="st-name" class="input" placeholder="Standard Mid-Term Template"/></div>
        <div>
          <label class="label">Category</label>
          <select id="st-cat" class="select">
            <option value="English">English</option>
            <option value="Urdu">Urdu</option>
            <option value="Science">Science</option>
            <option value="Math">Math</option>
            <option value="Custom">Custom</option>
          </select>
        </div>
      </div>
      <div class="form-grid g2" style="margin-bottom:12px">
        <div><label class="label">Subject (optional)</label><input type="text" id="st-subject" class="input" placeholder="e.g. Physics"/></div>
        <div>
          <label class="label">Language</label>
          <select id="st-lang" class="select">
            <option value="English">English</option>
            <option value="Urdu">Urdu</option>
          </select>
        </div>
      </div>
      <div style="margin-bottom:12px">
        <label class="label">Description</label>
        <textarea id="st-desc" class="input textarea" rows="2" placeholder="Brief description…"></textarea>
      </div>
      <div class="form-check">
        <input type="checkbox" id="st-public" class="form-check-input"/>
        <label for="st-public" class="form-check-label">Make public (visible to all users)</label>
      </div>
    </div>
  </div>
  <div class="modal-ft">
    <button class="btn btn-ghost btn-sm" onclick="G.closeModal('tmpl-modal')">Close</button>
    <button class="btn btn-primary btn-sm" id="tmpl-action-btn" onclick="G.tmplAction()">Apply Template</button>
  </div>
</div>
</div>

<!-- Loading overlay -->
<div id="gen-loading">
  <div class="gen-spin"></div>
  <div style="font-weight:600;font-size:1rem">Generating PDF…</div>
</div>

@Html.AntiForgeryToken()

<script>
  // Pass template settings from server to JS safely
  (function() {
    var raw = @Html.Raw(tmplJson);
    window._TMPL_JSON = raw;
  })();
</script>
<script src="~/js/apg.js" asp-append-version="true"></script>
<script src="~/js/generator.js" asp-append-version="true"></script>
</body>
</html>
