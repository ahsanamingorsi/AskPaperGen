@model List<TemplateListItem>
@{ ViewData["Title"] = "Templates"; Layout = "~/Views/Shared/_DashLayout.cshtml";
   var pub = ViewBag.PubTemplates as List<TemplateListItem> ?? []; }

<div class="page-hd">
  <div><h2>Templates</h2><p>Choose a template to start your paper</p></div>
</div>

@if (!Model.Any() && !pub.Any()) {
  <div class="empty-box"><div class="empty-icon">🗂️</div><h4>No templates available</h4><p>An admin needs to create templates first.</p></div>
} else {
  var icons = new Dictionary<string,string>{ ["English"]="📄",["Urdu"]="📜",["Science"]="🔬",["Math"]="📐",["Custom"]="⚙️" };
  var all = Model.UnionBy(pub, t=>t.Id).ToList();
  <div class="tmpl-grid">
  @foreach (var t in all) {
    <div class="tmpl-card">
      <div class="tmpl-thumb @(t.ThumbnailClass ?? "tmpl-custom")">
        <span>@(icons.GetValueOrDefault(t.Category??"","📋"))</span>
        <span class="tmpl-lang">@(t.Language??"EN")</span>
      </div>
      <div class="tmpl-info">
        <div class="tmpl-name">@t.Name</div>
        @if (!string.IsNullOrEmpty(t.Description)) { <div class="tmpl-desc">@t.Description</div> }
        <div class="tmpl-tags">
          @if (!string.IsNullOrEmpty(t.Category)) { <span class="tmpl-tag">@t.Category</span> }
          @if (t.IsBuiltIn) { <span class="tmpl-tag" style="background:var(--blue-l);color:var(--blue);border-color:var(--blue-m)">Built-in</span> }
        </div>
      </div>
      <div class="tmpl-acts">
        <a href="@Url.Action("Create","Paper",new{templateId=t.Id})" class="btn btn-primary btn-sm w-full" style="justify-content:center">
          <i class="bi bi-lightning-charge-fill"></i> Use
        </a>
      </div>
    </div>
  }
  </div>
}
