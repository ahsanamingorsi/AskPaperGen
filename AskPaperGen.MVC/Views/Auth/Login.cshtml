@model LoginVm
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Sign In — AskPaperGen</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
<link rel="stylesheet" href="~/css/apg.css"/>
</head><body>
<div class="auth-shell">
  <!-- Left -->
  <div class="auth-left">
    <div class="auth-inner">
      <a href="/" class="auth-brand">
        <div class="brand-ic"><i class="bi bi-journal-text"></i></div>
        <div class="auth-brand-name">Ask<em>Paper</em>Gen</div>
      </a>
      <div class="auth-illo">
        <div class="float-stack">
          <div class="fc a"><div class="fc-lbl">English Template</div><div class="fc-title">Mid-Term Examination</div><div class="fc-bar"><div class="fc-bar-fill" style="width:75%"></div></div><div class="fc-bar"><div class="fc-bar-fill" style="width:55%"></div></div></div>
          <div class="fc b"><div class="fc-lbl">Urdu Template</div><div class="fc-title">سالانہ امتحان</div><div class="fc-bar"><div class="fc-bar-fill" style="width:60%"></div></div></div>
          <div class="fc c"><div class="fc-lbl">PDF Ready</div><div class="fc-title">Science Final Term</div><div class="fc-bar"><div class="fc-bar-fill" style="width:85%"></div></div></div>
        </div>
        <div class="auth-tagline">
          <h2>Create Professional Exam Papers in Minutes</h2>
          <p>Template-driven paper generation with English &amp; Urdu support, live preview, and instant PDF export.</p>
          <div class="auth-bullets">
            <div class="ab"><div class="ab-dot"></div> No paper saving — direct PDF export</div>
            <div class="ab"><div class="ab-dot"></div> Admin-controlled templates</div>
            <div class="ab"><div class="ab-dot"></div> English &amp; Urdu (Nastaliq) support</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Right -->
  <div class="auth-right">
    <div class="auth-box">
      <div class="auth-box-logo"><div class="brand-ic" style="width:28px;height:28px;font-size:.82rem"><i class="bi bi-journal-text"></i></div> AskPaperGen</div>
      <h1 class="auth-title">Welcome back</h1>
      <p class="auth-subtitle">Sign in to start creating exam papers</p>

      <form asp-action="Login" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]"/>
        <div asp-validation-summary="ModelOnly" class="auth-err" style="display:@(ViewContext.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

        <div class="auth-field">
          <label asp-for="Email">Email Address</label>
          <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="email"/>
          <span asp-validation-for="Email" class="val-err"></span>
        </div>
        <div class="auth-field">
          <label asp-for="Password">Password</label>
          <div class="pw-wrap">
            <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password" id="pw"/>
            <button type="button" class="pw-eye"><i class="bi bi-eye" id="pw-ic"></i></button>
          </div>
          <span asp-validation-for="Password" class="val-err"></span>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
          <label style="display:flex;align-items:center;gap:6px;font-size:.85rem;color:var(--ink2);cursor:pointer">
            <input asp-for="RememberMe" type="checkbox" style="accent-color:var(--blue)"/> Remember me
          </label>
        </div>
        <button type="submit" class="auth-btn"><i class="bi bi-box-arrow-in-right" style="margin-right:6px"></i>Sign In</button>
      </form>

      <div class="auth-demo">
        <strong>Demo credentials:</strong><br/>
        demo&#64;askpapergen.com / Demo&#64;123456<br/>
        <strong>Admin:</strong> admin&#64;askpapergen.com / Admin&#64;123456
      </div>
      <p class="auth-switch">Don't have an account? <a asp-action="Register">Create one free</a></p>
    </div>
  </div>
</div>
<script src="~/js/apg.js"></script>
</body></html>
