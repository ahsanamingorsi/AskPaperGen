@model RegisterVm
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Create Account — AskPaperGen</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
<link rel="stylesheet" href="~/css/apg.css"/>
</head><body>
<div class="auth-shell">
  <div class="auth-left">
    <div class="auth-inner">
      <a href="/" class="auth-brand"><div class="brand-ic"><i class="bi bi-journal-text"></i></div><div class="auth-brand-name">Ask<em>Paper</em>Gen</div></a>
      <div class="auth-illo">
        <div class="float-stack">
          <div class="fc a"><div class="fc-lbl">3 Sections Ready</div><div class="fc-title">Mid-Term CS 2025</div><div class="fc-bar"><div class="fc-bar-fill" style="width:80%"></div></div></div>
          <div class="fc b"><div class="fc-lbl">PDF Generated</div><div class="fc-title">Physics Final Term</div><div class="fc-bar"><div class="fc-bar-fill" style="width:65%"></div></div></div>
        </div>
        <div class="auth-tagline">
          <h2>Join Thousands of Educators</h2>
          <p>Create professional exam papers in minutes using our template-driven system with full Urdu support.</p>
          <div class="auth-bullets">
            <div class="ab"><div class="ab-dot"></div> Free to use</div>
            <div class="ab"><div class="ab-dot"></div> Instant PDF download</div>
            <div class="ab"><div class="ab-dot"></div> English &amp; Urdu templates</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="auth-right">
    <div class="auth-box" style="max-width:460px">
      <div class="auth-box-logo"><div class="brand-ic" style="width:28px;height:28px;font-size:.82rem"><i class="bi bi-journal-text"></i></div> AskPaperGen</div>
      <h1 class="auth-title">Create account</h1>
      <p class="auth-subtitle">Start generating professional papers for free</p>
      <form asp-action="Register" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="auth-err" style="display:@(ViewContext.ModelState.ErrorCount>0?"block":"none")"></div>
        <div class="auth-field"><label asp-for="FullName">Full Name</label><input asp-for="FullName" placeholder="Dr. Ahmad Khan" autocomplete="name"/><span asp-validation-for="FullName" class="val-err"></span></div>
        <div class="auth-field"><label asp-for="Email">Email Address</label><input asp-for="Email" type="email" placeholder="you@university.edu" autocomplete="email"/><span asp-validation-for="Email" class="val-err"></span></div>
        <div class="auth-field"><label asp-for="Institution">Institution <span style="color:var(--ink4);font-weight:400">(optional)</span></label><input asp-for="Institution" placeholder="University of Technology"/></div>
        <div class="auth-field"><label asp-for="Password">Password</label><div class="pw-wrap"><input asp-for="Password" type="password" placeholder="Min 6 chars, 1 uppercase" id="pw2"/><button type="button" class="pw-eye"><i class="bi bi-eye"></i></button></div><span asp-validation-for="Password" class="val-err"></span></div>
        <div class="auth-field"><label asp-for="ConfirmPassword">Confirm Password</label><div class="pw-wrap"><input asp-for="ConfirmPassword" type="password" placeholder="Repeat password" id="pw3"/><button type="button" class="pw-eye"><i class="bi bi-eye"></i></button></div><span asp-validation-for="ConfirmPassword" class="val-err"></span></div>
        <button type="submit" class="auth-btn" style="margin-top:8px"><i class="bi bi-person-plus" style="margin-right:6px"></i>Create Account</button>
      </form>
      <p class="auth-switch">Already have an account? <a asp-action="Login">Sign in</a></p>
    </div>
  </div>
</div>
<script src="~/js/apg.js"></script>
</body></html>
