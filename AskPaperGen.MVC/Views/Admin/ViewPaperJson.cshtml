@{ViewData["Title"]="Paper JSON";Layout=null;}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Paper JSON – Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,600&display=swap" rel="stylesheet"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
<link rel="stylesheet" href="~/css/apg.css" asp-append-version="true"/>
</head>
<body style="background:var(--surf)">
<div class="apg-navbar-dash">
  <a href="/Home/Index" class="brand"><div class="brand-icon"><i class="bi bi-journal-text"></i></div><span>Ask<em>Paper</em>Gen</span></a>
  <div class="spacer"></div>
  <a href="@Url.Action("Papers","Admin")" class="btn-apg btn-ghost btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Papers</a>
</div>
<div style="max-width:900px;margin:80px auto;padding:0 24px 48px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <div>
      <h2 style="font-family:var(--fd);font-weight:800;margin:0 0 3px"><i class="bi bi-braces me-2" style="color:var(--blue)"></i>@ViewBag.PaperTitle</h2>
      <p style="color:var(--ink4);font-size:.82rem;margin:0">Owner: @ViewBag.OwnerName</p>
    </div>
    <button class="btn-apg btn-ghost btn-sm" onclick="copyJson()"><i class="bi bi-clipboard me-1"></i>Copy JSON</button>
  </div>
  <div class="apg-card">
    <pre class="json-viewer" id="jsonViewer">@ViewBag.PaperJson</pre>
  </div>
</div>
<script src="~/js/apg.js" asp-append-version="true"></script>
<script>
  try{
    const v=document.getElementById('jsonViewer');
    v.textContent=JSON.stringify(JSON.parse(v.textContent),null,2);
  }catch(e){}
  function copyJson(){
    navigator.clipboard.writeText(document.getElementById('jsonViewer').textContent)
      .then(()=>{const t=document.createElement('div');t.id='toast-area';t.innerHTML='<div class="apg-toast success"><span class="t-dot"></span>JSON copied!</div>';document.body.appendChild(t);setTimeout(()=>t.remove(),3000)});
  }
</script>
</body></html>
