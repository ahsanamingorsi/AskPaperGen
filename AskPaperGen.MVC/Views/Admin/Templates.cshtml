@model List<TemplateListItem>
@{ ViewData["Title"] = "Templates"; Layout = "~/Views/Shared/_DashLayout.cshtml"; }

<div class="page-hd">
  <div><h2><i class="bi bi-layout-text-window-reverse" style="color:var(--purple);margin-right:8px"></i>All Templates</h2><p>@Model.Count template@(Model.Count!=1?"s":"")</p></div>
  <a href="@Url.Action("NewTemplate","Admin")" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Template</a>
</div>

@if (!Model.Any()) {
  <div class="empty-box"><div class="empty-icon">🗂️</div><h4>No templates yet</h4><p>Create a template so users can generate papers.</p><a href="@Url.Action("NewTemplate","Admin")" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Create Template</a></div>
} else {
  var icons = new Dictionary<string,string>{ ["English"]="📄",["Urdu"]="📜",["Science"]="🔬",["Math"]="📐",["Custom"]="⚙️" };
  <div class="tmpl-grid">
  @foreach (var t in Model) {
    <div class="tmpl-card">
      <div class="tmpl-thumb @(t.ThumbnailClass ?? "tmpl-custom")">
        <span>@(icons.GetValueOrDefault(t.Category??"","📋"))</span>
        <span class="tmpl-lang">@(t.Language??"EN")</span>
      </div>
      <div class="tmpl-info">
        <div class="tmpl-name">@t.Name</div>
        @if (!string.IsNullOrEmpty(t.Description)) { <div class="tmpl-desc">@t.Description</div> }
        <div class="tmpl-tags">
          @if(!string.IsNullOrEmpty(t.Category)){<span class="tmpl-tag">@t.Category</span>}
          @if(t.IsBuiltIn){<span class="tmpl-tag" style="background:var(--blue-l);color:var(--blue);border-color:var(--blue-m)">Built-in</span>}
          @if(t.IsPublic){<span class="tmpl-tag" style="background:var(--green-l);color:var(--green);border-color:var(--green-m)">Public</span>}
        </div>
        <div style="font-size:.72rem;color:var(--ink4);margin-top:6px">@(t.OwnerName??"—") · @t.CreatedAt.ToString("MMM d, yyyy")</div>
      </div>
      <div class="tmpl-acts">
        <a href="@Url.Action("EditTemplate","Admin",new{id=t.Id})" class="btn btn-secondary btn-sm" style="flex:1;justify-content:center"><i class="bi bi-pencil"></i> Edit</a>
        <form asp-action="DeleteTemplate" asp-route-id="@t.Id" method="post" style="display:inline" onsubmit="return confirm('Delete this template?')">
          @Html.AntiForgeryToken()
          <button class="btn-icon danger" title="Delete"><i class="bi bi-trash"></i></button>
        </form>
      </div>
    </div>
  }
  </div>
}
