@model AskPaperGen.Models.SiteSettings
@{ ViewData["Title"] = "Site Settings"; Layout = "~/Views/Shared/_DashLayout.cshtml"; }

<div class="page-hd">
  <div><h2><i class="bi bi-gear-fill" style="color:var(--blue);margin-right:8px"></i>Site Settings</h2><p>Control global behaviour of AskPaperGen</p></div>
</div>

<form asp-controller="Admin" asp-action="SaveSettings" method="post" style="max-width:600px">
  @Html.AntiForgeryToken()
  <div class="card" style="margin-bottom:20px">
    <div class="card-hd">
      <div class="card-hd-left"><div class="card-icon ci-amber"><i class="bi bi-shield-exclamation"></i></div><div><div class="card-title">Paper Saving</div><div class="card-sub">Control whether users can save papers to the database</div></div></div>
    </div>
    <div class="card-body">
      <div class="toggle-row" style="margin-bottom:16px">
        <div><div class="toggle-row-label">Disable paper saving</div><div class="toggle-row-sub">When enabled, users can only export PDF — no server storage.</div></div>
        <label class="toggle">
          <input type="checkbox" name="PaperSavingDisabled" value="true" @(Model.PaperSavingDisabled ? "checked" : "")/>
          <div class="toggle-track"></div>
        </label>
      </div>
      <div>
        <label class="label">Notice message shown to users</label>
        <textarea name="PaperSavingDisabledMessage" class="input textarea" rows="3"
                  placeholder="Message displayed when saving is disabled…">@Model.PaperSavingDisabledMessage</textarea>
        <div style="font-size:.78rem;color:var(--ink3);margin-top:5px">This message appears on the dashboard and paper generator.</div>
      </div>
    </div>
  </div>
  <button type="submit" class="btn btn-primary"><i class="bi bi-floppy2"></i> Save Settings</button>
</form>
