@model TemplateBuilderVm
@{
  ViewData["Title"] = Model.Id > 0 ? "Edit Template" : "New Template";
  Layout = null;
  bool isNew = Model.Id == 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>@ViewData["Title"] — AskPaperGen Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Noto+Nastaliq+Urdu:wght@400;600;700&display=swap" rel="stylesheet"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
<link rel="stylesheet" href="~/css/apg.css" asp-append-version="true"/>
<style>
html,body{height:100%;overflow:hidden}
.td-shell{display:grid;grid-template-columns:320px 1fr;height:calc(100vh - 54px);margin-top:54px;overflow:hidden}
.td-panel{background:#fff;border-right:1px solid var(--border);overflow-y:auto;padding:0;display:flex;flex-direction:column}
.td-preview{background:#e2e8f0;overflow-y:auto;padding:20px}
.td-tabs{display:flex;gap:2px;background:var(--bg);padding:4px;margin:12px 12px 0}
.td-tab{flex:1;padding:7px 8px;border-radius:6px;font-family:var(--fb);font-weight:600;font-size:.78rem;border:none;background:transparent;color:var(--ink4);cursor:pointer;transition:.12s;text-align:center}
.td-tab.on{background:#fff;color:var(--blue);box-shadow:var(--sh-xs)}
.td-pane{display:none;padding:14px 16px;flex:1}
.td-pane.on{display:block}
.spreset-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}
.sp-row{border:1.5px solid var(--border);border-radius:var(--r);padding:12px;background:#fff;margin-bottom:8px}
.sp-row-hd{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.sp-row-title{font-family:var(--fd);font-weight:700;font-size:.85rem}
.paper-sheet-sm{background:#fff;box-shadow:0 2px 12px rgba(0,0,0,.15);padding:24px 28px;font-size:9.5pt;line-height:1.6;color:#000;min-height:800px;max-width:660px;margin:0 auto;transform-origin:top center}
@@media(max-width:900px){.td-shell{grid-template-columns:1fr}.td-preview{display:none}}
</style>
</head>
<body>

<!-- Topbar -->
<div class="app-nav">
  <a href="@Url.Action("Templates","Admin")" class="btn-icon" style="margin-right:4px"><i class="bi bi-arrow-left"></i></a>
  <div class="brand"><div class="brand-ic"><i class="bi bi-journal-text"></i></div><span>Ask<em>Paper</em>Gen</span></div>
  <span class="chip chip-red" style="margin-left:8px;font-size:.7rem"><i class="bi bi-shield-fill"></i> Admin</span>
  <span class="chip chip-purple" style="margin-left:4px;font-size:.7rem">Template Designer</span>
  <div class="nav-spacer"></div>
  <div style="display:flex;align-items:center;gap:8px">
    <span id="save-ind" style="font-size:.78rem;color:var(--ink3)"></span>
    <button class="btn btn-ghost btn-sm" onclick="history.back()"><i class="bi bi-arrow-left"></i> Back</button>
    <button class="btn btn-primary btn-sm" onclick="saveTmpl()"><i class="bi bi-floppy2"></i> Save Template</button>
  </div>
</div>

<div class="td-shell">
<!-- LEFT: Settings -->
<aside class="td-panel">
  <div class="td-tabs">
    <button class="td-tab on" data-p="general">General</button>
    <button class="td-tab" data-p="design">Design</button>
    <button class="td-tab" data-p="sections">Sections</button>
    <button class="td-tab" data-p="instrs">Instructions</button>
  </div>

  <!-- GENERAL -->
  <div class="td-pane on" id="tp_general">
    <div style="margin-bottom:14px"><label class="label">Template Name *</label><input type="text" id="t_name" class="input" value="@Model.Name" placeholder="Standard English Exam"/></div>
    <div style="margin-bottom:14px"><label class="label">Description</label><textarea id="t_desc" class="input textarea" rows="2" placeholder="When to use this template…">@Model.Description</textarea></div>
    <div class="form-grid g2" style="margin-bottom:14px">
      <div><label class="label">Category</label>
      <select id="t_cat" class="select" onchange="updatePreview()">
@foreach (var c in new[] { "English", "Urdu", "Science", "Math", "Custom" })
{
    if (Model.Category == c)
    {
        <option value="@c" selected>@c</option>
    }
    else
    {
        <option value="@c">@c</option>
    }
}
</select>
      </div>
      <div><label class="label">Language</label>
     <select id="t_lang" class="select" onchange="onLangChange()">
    <option value="English" selected="@(Model.Language == "English")">
        English (LTR)
    </option>

    <option value="Urdu" selected="@(Model.Language == "Urdu")">
        Urdu (RTL)
    </option>
</select>
      </div>
    </div>
    <div style="margin-bottom:14px"><label class="label">Subject Tag <span style="color:var(--ink4);font-weight:400">(optional)</span></label><input type="text" id="t_subject" class="input" value="@Model.Subject" placeholder="Mathematics, Physics…"/></div>
    <div class="form-check"><input type="checkbox" id="t_public" class="form-check-input" @(Model.IsPublic?"checked":"")/>  <label for="t_public" class="form-check-label">Make public (visible to all users)</label></div>
  </div>

  <!-- DESIGN -->
  <div class="td-pane" id="tp_design">
    <div style="margin-bottom:14px">
      <label class="label">Primary Color</label>
      <div class="swatch-row" id="td-swatches">
        @foreach(var c in new[]{"#1e3a8a","#2563eb","#0f766e","#166534","#7c3aed","#9a3412","#8b0000","#0f172a","#0369a1","#b45309","#be123c","#374151"}){
          <span class="swatch" style="background:@c" data-c="@c" title="@c"></span>}
      </div>
      <input type="color" id="d_color" class="input" value="#1e3a8a" style="height:34px;padding:2px 6px;cursor:pointer;margin-top:8px;width:100%" oninput="syncColor(this.value)"/>
    </div>
    <div class="form-grid g2" style="margin-bottom:14px">
      <div><label class="label">Header Style</label>
        <select id="d_hstyle" class="select" onchange="updatePreview()">
          <option value="band">Color Band</option><option value="line">Double Line</option>
          <option value="minimal">Minimal</option><option value="box">Box Border</option>
        </select>
      </div>
      <div><label class="label">Section Style</label>
        <select id="d_sstyle" class="select" onchange="updatePreview()">
          <option value="sidebar">Side Bar</option><option value="underline">Underline</option>
          <option value="band">Band</option><option value="box">Box</option>
        </select>
      </div>
    </div>
    <div class="form-grid g2" style="margin-bottom:14px">
      <div><label class="label">Font Family</label>
        <select id="d_font" class="select" onchange="updatePreview()">
          <option value="times">Times New Roman</option><option value="arial">Arial</option>
          <option value="calibri">Calibri</option><option value="urdu">Urdu Nastaliq</option>
        </select>
      </div>
      <div><label class="label">Font Size</label>
        <select id="d_fsize" class="select" onchange="updatePreview()">
          <option value="10">10pt</option><option value="11" selected>11pt</option><option value="12">12pt</option>
        </select>
      </div>
    </div>
    <div style="border:1px solid var(--border);border-radius:var(--r);padding:4px 12px">
      <div class="toggle-row"><div class="toggle-row-label">Show logo area</div><label class="toggle"><input type="checkbox" id="d_logo" checked onchange="updatePreview()"/><div class="toggle-track"></div></label></div>
      <div class="toggle-row"><div class="toggle-row-label">Show answer lines</div><label class="toggle"><input type="checkbox" id="d_anslines" checked onchange="updatePreview()"/><div class="toggle-track"></div></label></div>
      <div class="toggle-row"><div class="toggle-row-label">Show marks column</div><label class="toggle"><input type="checkbox" id="d_marks" checked onchange="updatePreview()"/><div class="toggle-track"></div></label></div>
      <div class="toggle-row"><div class="toggle-row-label">Show general instructions</div><label class="toggle"><input type="checkbox" id="d_instrs" checked onchange="updatePreview()"/><div class="toggle-track"></div></label></div>
      <div class="toggle-row"><div class="toggle-row-label">Show page numbers</div><label class="toggle"><input type="checkbox" id="d_pagenums" checked onchange="updatePreview()"/><div class="toggle-track"></div></label></div>
    </div>

    <!-- Header elements order -->
    <div style="margin-top:16px">
      <label class="label mb2" style="margin-bottom:8px">Header Element Visibility</label>
      <div style="border:1px solid var(--border);border-radius:var(--r);padding:4px 12px" id="hdr-elements">
        <div class="toggle-row"><div class="toggle-row-label">Institute name</div><label class="toggle"><input type="checkbox" id="he_institute" checked onchange="updatePreview()"/><div class="toggle-track"></div></label></div>
        <div class="toggle-row"><div class="toggle-row-label">Affiliation line</div><label class="toggle"><input type="checkbox" id="he_affiliation" checked onchange="updatePreview()"/><div class="toggle-track"></div></label></div>
        <div class="toggle-row"><div class="toggle-row-label">Department</div><label class="toggle"><input type="checkbox" id="he_department" checked onchange="updatePreview()"/><div class="toggle-track"></div></label></div>
        <div class="toggle-row"><div class="toggle-row-label">Exam type band/line</div><label class="toggle"><input type="checkbox" id="he_examband" checked onchange="updatePreview()"/><div class="toggle-track"></div></label></div>
        <div class="toggle-row"><div class="toggle-row-label">Subject line</div><label class="toggle"><input type="checkbox" id="he_subject" checked onchange="updatePreview()"/><div class="toggle-track"></div></label></div>
        <div class="toggle-row"><div class="toggle-row-label">Meta grid (marks/duration/date)</div><label class="toggle"><input type="checkbox" id="he_meta" checked onchange="updatePreview()"/><div class="toggle-track"></div></label></div>
        <div class="toggle-row"><div class="toggle-row-label">Name / Roll No bar</div><label class="toggle"><input type="checkbox" id="he_namebar" checked onchange="updatePreview()"/><div class="toggle-track"></div></label></div>
      </div>
    </div>
  </div>

  <!-- SECTIONS PRESETS -->
  <div class="td-pane" id="tp_sections">
    <p style="font-size:.82rem;color:var(--ink3);margin-bottom:12px">Define default sections that appear when users select this template.</p>
    <div id="sec-preset-list"></div>
    <button class="btn btn-secondary btn-sm w-full" style="justify-content:center;margin-top:6px" onclick="addPreset()"><i class="bi bi-plus-lg"></i> Add Section Preset</button>
  </div>

  <!-- INSTRUCTIONS -->
  <div class="td-pane" id="tp_instrs">
    <p style="font-size:.82rem;color:var(--ink3);margin-bottom:12px">Default general instructions shown on papers using this template.</p>
    <div id="instr-list-td" style="margin-bottom:10px"></div>
    <div style="display:flex;gap:7px">
      <input type="text" id="instr-add-td" class="input" style="flex:1" placeholder="Add instruction…"/>
      <button class="btn btn-ghost btn-sm" onclick="addInstrTd()"><i class="bi bi-plus-lg"></i></button>
    </div>
  </div>
</aside>

<!-- RIGHT: Preview -->
<main class="td-preview">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
    <h6 style="font-family:var(--fd);font-weight:700;margin:0"><i class="bi bi-eye" style="margin-right:6px"></i>Live Preview</h6>
    <select id="prev-scale" class="select" style="width:90px;padding:5px 8px;font-size:.78rem" onchange="setScale()">
      <option value="0.6">60%</option><option value="0.7" selected>70%</option><option value="0.85">85%</option><option value="1">100%</option>
    </select>
  </div>
  <div id="prev-wrap" style="transform-origin:top left">
    <div class="paper-sheet-sm" id="td-preview"></div>
  </div>
</main>
</div>

@Html.AntiForgeryToken()

<script>
// ── Bootstrap ────────────────────────────────────────────────────
const TMPL_ID   = @Model.Id;
const INIT_SETT = @Html.Raw(string.IsNullOrEmpty(Model.SettingsJson)||Model.SettingsJson=="{}"?"null":Model.SettingsJson);

let S = {
  primaryColor:'#1e3a8a', headerStyle:'band', sectionStyle:'sidebar',
  fontFamily:'times', fontSize:11, rtl:false,
  showLogo:true, showAnswerLines:true, showMarks:true,
  showInstructions:true, showPageNums:true,
  headerElements:['institute','affiliation','department','examband','subject','meta','namebar'],
  defaultInstructions:[
    'All questions are compulsory unless otherwise stated.',
    'Write legibly in the space provided.',
    'Use of mobile phones is strictly prohibited.'
  ],
  sectionPresets:[]
};

document.addEventListener('DOMContentLoaded',()=>{
  if(INIT_SETT) try{ Object.assign(S,INIT_SETT); }catch{}
  loadToUI();
  renderPresets();
  renderInstrs();
  updatePreview();
  setScale();

  // Tabs
  document.querySelectorAll('.td-tab').forEach(t=>t.addEventListener('click',()=>{
    document.querySelectorAll('.td-tab,.td-pane').forEach(x=>x.classList.remove('on'));
    t.classList.add('on');
    document.getElementById('tp_'+t.dataset.p)?.classList.add('on');
  }));
  // Swatches
  document.querySelectorAll('#td-swatches .swatch').forEach(sw=>sw.addEventListener('click',()=>{
    document.querySelectorAll('#td-swatches .swatch').forEach(s=>s.classList.remove('on'));
    sw.classList.add('on');
    document.getElementById('d_color').value=sw.dataset.c;
    syncColor(sw.dataset.c);
  }));
  // Design inputs live update
  document.querySelectorAll('#tp_design select,#tp_design input[type=color]').forEach(el=>el.addEventListener('change',()=>{syncFromUI();updatePreview();}));
  // Enter key for instruction
  document.getElementById('instr-add-td')?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();addInstrTd();}});
});

function loadToUI(){
  setV('d_color',S.primaryColor);
  setV('d_hstyle',S.headerStyle); setV('d_sstyle',S.sectionStyle);
  setV('d_font',S.fontFamily);    setV('d_fsize',String(S.fontSize));
  chk('d_logo',S.showLogo); chk('d_anslines',S.showAnswerLines);
  chk('d_marks',S.showMarks); chk('d_instrs',S.showInstructions);
  chk('d_pagenums',S.showPageNums);
  // Header elements
  ['institute','affiliation','department','examband','subject','meta','namebar'].forEach(k=>{
    chk('he_'+k,(S.headerElements||[]).includes(k));
  });
  document.querySelectorAll('#td-swatches .swatch').forEach(sw=>
    sw.classList.toggle('on',sw.dataset.c?.toLowerCase()===S.primaryColor?.toLowerCase()));
  if(S.rtl) setV('t_lang','Urdu');
}

function syncFromUI(){
  S.primaryColor    = gV('d_color');
  S.headerStyle     = gV('d_hstyle');
  S.sectionStyle    = gV('d_sstyle');
  S.fontFamily      = gV('d_font');
  S.fontSize        = parseFloat(gV('d_fsize'))||11;
  S.showLogo        = gck('d_logo');
  S.showAnswerLines = gck('d_anslines');
  S.showMarks       = gck('d_marks');
  S.showInstructions= gck('d_instrs');
  S.showPageNums    = gck('d_pagenums');
  S.headerElements  = ['institute','affiliation','department','examband','subject','meta','namebar'].filter(k=>gck('he_'+k));
}

function syncColor(c){
  document.querySelectorAll('#td-swatches .swatch').forEach(s=>s.classList.toggle('on',s.dataset.c?.toLowerCase()===c?.toLowerCase()));
  S.primaryColor=c; updatePreview();
}

function onLangChange(){
  S.rtl=gV('t_lang')==='Urdu';
  if(S.rtl) setV('d_font','urdu');
  updatePreview();
}

// ── Section Presets ───────────────────────────────────────────────
function renderPresets(){
  const el=document.getElementById('sec-preset-list'); if(!el) return;
  el.innerHTML=S.sectionPresets.map((p,i)=>`
    <div class="sp-row">
      <div class="sp-row-hd">
        <span class="sp-row-title">Section ${i+1}</span>
        <button class="btn-icon danger" onclick="delPreset(${i})"><i class="bi bi-trash"></i></button>
      </div>
      <div class="form-grid g2" style="margin-bottom:8px">
        <div><label class="label">Title</label><input type="text" class="input" value="${esc(p.title)}" oninput="updPreset(${i},'title',this.value)"/></div>
        <div><label class="label">Attempt Rule</label><input type="text" class="input" value="${esc(p.attemptRule||'')}" oninput="updPreset(${i},'attemptRule',this.value)"/></div>
      </div>
      <div class="form-grid g2" style="margin-bottom:8px">
        <div><label class="label">Q Type</label>
          <select class="select" onchange="updPreset(${i},'questionType',this.value)">
            ${['mcq','short','long','mixed'].map(t=>`<option value="${t}" ${p.questionType===t?'selected':''}>${t}</option>`).join('')}
          </select>
        </div>
        <div><label class="label">Default Marks</label><input type="number" class="input" value="${p.defaultMarks||1}" min="0" oninput="updPreset(${i},'defaultMarks',+this.value)"/></div>
      </div>
      <div><label class="label">Instructions</label><textarea class="input textarea" rows="1" oninput="updPreset(${i},'instructions',this.value)">${esc(p.instructions||'')}</textarea></div>
    </div>`).join('');
}
function addPreset(){S.sectionPresets.push({title:`Section ${String.fromCharCode(65+S.sectionPresets.length)}`,instructions:'',attemptRule:'',defaultMarks:5,questionType:'mixed'});renderPresets();updatePreview();}
function delPreset(i){S.sectionPresets.splice(i,1);renderPresets();updatePreview();}
function updPreset(i,k,v){S.sectionPresets[i][k]=v;updatePreview();}

// ── Instructions ──────────────────────────────────────────────────
function renderInstrs(){
  const el=document.getElementById('instr-list-td'); if(!el) return;
  el.innerHTML=S.defaultInstructions.map((ln,i)=>`
    <div style="display:flex;gap:7px;align-items:center;margin-bottom:6px">
      <div style="width:22px;height:22px;border-radius:50%;background:var(--blue);color:#fff;font-size:.7rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0">${i+1}</div>
      <input type="text" class="input" style="flex:1;padding:6px 10px;font-size:.82rem" value="${esc(ln)}" oninput="S.defaultInstructions[${i}]=this.value;updatePreview()"/>
      <button class="btn-icon danger" onclick="S.defaultInstructions.splice(${i},1);renderInstrs();updatePreview()"><i class="bi bi-trash"></i></button>
    </div>`).join('');
}
function addInstrTd(){const inp=document.getElementById('instr-add-td');const v=inp?.value?.trim();if(!v)return;S.defaultInstructions.push(v);inp.value='';renderInstrs();updatePreview();}

// ── Live preview ──────────────────────────────────────────────────
function updatePreview(){
  syncFromUI();
  const pc=S.primaryColor||'#1e3a8a';
  const rtl=S.rtl||gV('t_lang')==='Urdu';
  const ff={times:"'Times New Roman',Times,serif",arial:"Arial,Helvetica,sans-serif",calibri:"Calibri,Candara,sans-serif",urdu:"'Noto Nastaliq Urdu','Traditional Arabic',serif"};
  const pv=document.getElementById('td-preview'); if(!pv) return;
  pv.style.fontFamily=ff[S.fontFamily]||ff.times;
  pv.style.fontSize=(S.fontSize||11)+'pt';
  pv.style.direction=rtl?'rtl':'ltr';
  pv.style.textAlign=rtl?'right':'left';

  const he=S.headerElements||[];
  const hs=S.headerStyle||'band';
  let h='';

  if(hs==='band'){
    if(he.includes('institute')) h+=`<div style="font-size:13pt;font-weight:700;text-align:center;color:${pc}">University / Institute Name</div>`;
    if(he.includes('affiliation')) h+=`<div style="font-size:8.5pt;text-align:center;color:#555">Affiliated with Higher Education Commission</div>`;
    if(he.includes('department'))  h+=`<div style="font-size:9pt;text-align:center;color:#333">Department of Computer Science</div>`;
    if(he.includes('examband'))    h+=`<div style="font-weight:700;font-size:10pt;text-transform:uppercase;letter-spacing:.04em;text-align:center;padding:6px;margin:6px 0;color:#fff;background:${pc}">MID-TERM EXAMINATION 2025</div>`;
  } else if(hs==='line'){
    h+=`<div style="text-align:center;border-top:2px solid ${pc};border-bottom:2px solid ${pc};padding:7px 0;margin-bottom:8px">`;
    if(he.includes('institute')) h+=`<div style="font-size:13pt;font-weight:700;color:${pc}">University / Institute Name</div>`;
    if(he.includes('examband'))  h+=`<div style="font-weight:700;font-size:10pt">MID-TERM EXAMINATION 2025</div>`;
    h+=`</div>`;
  } else if(hs==='minimal'){
    if(he.includes('institute')) h+=`<div style="font-size:13pt;font-weight:700;text-align:center;color:${pc};margin-bottom:4px">University / Institute Name</div>`;
    if(he.includes('examband'))  h+=`<div style="text-align:center;font-size:10pt;font-weight:600;margin-bottom:6px">Mid-Term Examination 2025</div>`;
  } else {
    h+=`<div style="text-align:center;border:2px solid ${pc};border-radius:3px;padding:10px;margin-bottom:8px">`;
    if(he.includes('institute')) h+=`<div style="font-size:13pt;font-weight:700;color:${pc}">University / Institute Name</div>`;
    if(he.includes('examband'))  h+=`<div style="font-weight:700;font-size:10pt">MID-TERM EXAMINATION 2025</div>`;
    h+=`</div>`;
  }

  if(he.includes('subject')) h+=`<div style="font-weight:700;font-size:11pt;text-align:center;margin:5px 0 8px">Subject: Data Structures &amp; Algorithms</div>`;
  if(he.includes('meta'))    h+=`<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:2px 12px;font-size:8.5pt;border-top:1px solid #000;border-bottom:1px solid #ddd;padding:5px 0;margin-bottom:8px"><div><b>Total Marks:</b> 100</div><div><b>Duration:</b> 3 Hours</div><div><b>Date:</b> 2025-01-15</div></div>`;
  h+=`<hr style="border:none;border-top:1.5px solid #000;margin:6px 0"/>`;
  if(he.includes('namebar')) h+=`<div style="display:flex;justify-content:space-between;font-size:8.5pt;margin-bottom:10px"><span>Name: ___________________________</span><span>Roll No: ___________</span><span>Marks: _______</span></div>`;

  if(S.showInstructions&&S.defaultInstructions.length){
    h+=`<div style="background:#f7f9ff;border-left:4px solid ${pc};padding:8px 12px;font-size:8.5pt;margin-bottom:12px"><b>General Instructions:</b><ol style="margin:2px 0 0;padding-left:16px">`;
    S.defaultInstructions.forEach(l=>h+=`<li>${esc(l)}</li>`); h+=`</ol></div>`;
  }

  // Sections preview
  S.sectionPresets.forEach((sp,si)=>{
    const ss=S.sectionStyle||'sidebar';
    if(ss==='band') h+=`<div style="font-weight:700;font-size:9pt;text-transform:uppercase;padding:5px 8px;margin:12px 0 7px;color:#fff;background:${pc}">${esc(sp.title||'Section '+(si+1))}</div>`;
    else if(ss==='underline') h+=`<div style="font-weight:700;font-size:9pt;border-bottom:2px solid ${pc};padding-bottom:3px;margin:12px 0 7px;color:${pc}">${esc(sp.title||'Section '+(si+1))}</div>`;
    else if(ss==='box') h+=`<div style="font-weight:700;font-size:9pt;border:1.5px solid ${pc};padding:4px 8px;margin:12px 0 7px;color:${pc};text-align:center">${esc(sp.title||'Section '+(si+1))}</div>`;
    else h+=`<div style="font-weight:700;font-size:9pt;text-transform:uppercase;padding:5px 8px;margin:12px 0 7px;border-left:5px solid ${pc};background:${pc}18">${esc(sp.title||'Section '+(si+1))}</div>`;
    if(sp.attemptRule)   h+=`<div style="font-size:8.5pt;font-style:italic;color:#666;margin-bottom:5px">${esc(sp.attemptRule)}</div>`;
    if(sp.instructions)  h+=`<div style="font-size:8.5pt;font-style:italic;color:#555;margin-bottom:7px">${esc(sp.instructions)}</div>`;
    for(let q=1;q<=2;q++){
      h+=`<div style="display:flex;gap:7px;margin-bottom:9px"><span style="font-weight:700;min-width:24px;flex-shrink:0">Q${q}.</span><div style="flex:1">`;
      if(sp.questionType==='mcq'){ h+=`Sample MCQ question ${q}? <span style="color:#888;font-size:8pt">[${sp.defaultMarks}m]</span><div style="display:flex;flex-wrap:wrap;gap:2px 20px;margin-top:3px;font-size:9pt">(A) Option A &nbsp;(B) Option B &nbsp;(C) Option C &nbsp;(D) Option D</div>`; }
      else { h+=`Sample ${sp.questionType} question ${q} for this section. <span style="color:#888;font-size:8pt">[${sp.defaultMarks}m]</span>`;
        if(S.showAnswerLines){ const n=sp.questionType==='long'?5:3; for(let l=0;l<n;l++) h+=`<div style="border-bottom:1px solid #ccc;height:18px;margin-bottom:3px"></div>`; }
      }
      h+=`</div></div>`;
    }
  });

  if(!S.sectionPresets.length) h+=`<div style="text-align:center;color:#bbb;padding:40px 0;font-size:10pt">Add section presets to preview structure</div>`;
  if(S.showPageNums) h+=`<div style="border-top:1px solid #000;margin-top:20px;padding-top:7px;display:flex;justify-content:space-between;font-size:8pt;color:#666"><span>University Name · Mid-Term Exam</span><span>Page 1 of 1 | AskPaperGen</span></div>`;

  pv.innerHTML=h;
}

function setScale(){const s=parseFloat(document.getElementById('prev-scale')?.value||.7);document.getElementById('prev-wrap').style.transform=`scale(${s})`;}

// ── Save ──────────────────────────────────────────────────────────
async function saveTmpl(){
  syncFromUI();
  const name=gV('t_name').trim(); if(!name){alert('Template name is required.');return;}
  const payload={
    id:TMPL_ID, name, description:gV('t_desc'),
    category:gV('t_cat'), subject:gV('t_subject'),
    language:gV('t_lang'), isPublic:gck('t_public'),
    settingsJson:JSON.stringify(S)
  };
  const ind=document.getElementById('save-ind');
  ind.textContent='Saving…';
  try{
    const csrf=document.querySelector('input[name="__RequestVerificationToken"]')?.value??'';
    const res=await fetch('/Admin/SaveTemplateAjax',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':csrf},body:JSON.stringify(payload)});
    if(!res.ok) throw new Error(`HTTP ${res.status}`);
    const data=await res.json();
    ind.innerHTML='<span style="color:var(--green)">✓ Saved</span>';
    if(TMPL_ID===0 && data.id) setTimeout(()=>window.location.href=`/Admin/EditTemplate/${data.id}`,600);
  }catch(e){ind.innerHTML=`<span style="color:var(--red)">Error: ${e.message}</span>`;}
  setTimeout(()=>{ind.textContent=''},5000);
}

function gV(id){return document.getElementById(id)?.value??''}
function setV(id,v){const el=document.getElementById(id);if(el&&v!=null) el.value=String(v)}
function gck(id){return document.getElementById(id)?.checked??false}
function chk(id,v){const el=document.getElementById(id);if(el) el.checked=!!v}
function esc(s){return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
</script>
