@using Microsoft.AspNetCore.Identity
@inject UserManager<AskPaperGen.Models.ApplicationUser> UM
@{
  var user = await UM.GetUserAsync(User);
  var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
  var act  = ViewContext.RouteData.Values["action"]?.ToString();
  bool On(string c, string? a=null) => ctrl==c && (a==null||act==a);
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>@ViewData["Title"] — AskPaperGen</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="~/css/apg.css" asp-append-version="true"/>
  @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- Navbar -->
<header class="app-nav">
  <button class="hamburger" id="ham" aria-label="Menu"><i class="bi bi-list"></i></button>
  <a href="/" class="brand">
    <div class="brand-ic"><i class="bi bi-journal-text"></i></div>
    <span>Ask<em>Paper</em>Gen</span>
  </a>
  <div class="nav-spacer"></div>
  @if (User.IsInRole("Admin")) {
    <a href="@Url.Action("Index","Admin")" class="chip chip-red no-print" style="margin-right:4px;font-size:.7rem">
      <i class="bi bi-shield-fill"></i> Admin
    </a>
  }
  <div style="display:flex;align-items:center;gap:8px">
    <div class="avatar" title="@user?.Email">@(user?.AvatarInitials ?? "U")</div>
    <span class="md-flex" style="font-size:.875rem;font-weight:500;color:var(--ink);display:none">@(user?.FullName?.Split(' ')[0]??"")</span>
    <form asp-controller="Auth" asp-action="Logout" method="post" style="margin:0">
      @Html.AntiForgeryToken()
      <button type="submit" class="btn btn-ghost btn-sm no-print">
        <i class="bi bi-box-arrow-right"></i>
        <span class="sm-flex" style="display:none">Logout</span>
      </button>
    </form>
  </div>
</header>

<!-- Sidebar overlay -->
<div class="sb-overlay" id="sbov"></div>

<!-- Sidebar -->
<aside class="app-sidebar" id="sb">
  <div class="sb-body">
    <span class="sb-section">Main</span>
    <ul class="sb-nav">
      <li><a href="@Url.Action("Index","Dashboard")" class="@(On("Dashboard","Index")?"on":"")"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a></li>
      <li><a href="@Url.Action("Create","Paper")"    class="@(On("Paper","Create")?"on":"")"><i class="bi bi-plus-circle-fill"></i> New Paper</a></li>
    </ul>
    <span class="sb-section">Templates</span>
    <ul class="sb-nav">
      <li><a href="@Url.Action("MyTemplates","Dashboard")" class="@(On("Dashboard","MyTemplates")?"on":"")"><i class="bi bi-layout-text-window-reverse"></i> My Templates</a></li>
    </ul>
    @if (User.IsInRole("Admin")) {
      <span class="sb-section">Admin</span>
      <ul class="sb-nav">
        <li><a href="@Url.Action("Index","Admin")"     class="@(On("Admin","Index")?"on":"")"><i class="bi bi-shield-fill-check"></i> Admin Home</a></li>
        <li><a href="@Url.Action("Templates","Admin")" class="@(On("Admin","Templates")||On("Admin","EditTemplate")||On("Admin","NewTemplate")?"on":"")"><i class="bi bi-layout-text-window-reverse"></i> Templates</a></li>
        <li><a href="@Url.Action("Users","Admin")"     class="@(On("Admin","Users")?"on":"")"><i class="bi bi-people-fill"></i> Users</a></li>
        <li><a href="@Url.Action("Settings","Admin")"  class="@(On("Admin","Settings")?"on":"")"><i class="bi bi-gear-fill"></i> Settings</a></li>
      </ul>
    }
  </div>
  <div class="sb-foot">
    <div style="display:flex;align-items:center;gap:8px;min-width:0">
      <div class="avatar" style="width:30px;height:30px;font-size:.7rem;flex-shrink:0">@(user?.AvatarInitials??"U")</div>
      <div style="min-width:0;overflow:hidden">
        <div style="font-weight:600;font-size:.8rem;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@user?.FullName</div>
        <div style="font-size:.7rem;color:var(--ink4);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@user?.Email</div>
      </div>
    </div>
  </div>
</aside>

@if (TempData["Success"] != null) {
  <div id="toast-area"><div class="toast ok"><span class="tdot"></span><span>@TempData["Success"]</span></div></div>
}
@if (TempData["Error"] != null) {
  <div id="toast-area"><div class="toast err"><span class="tdot"></span><span>@TempData["Error"]</span></div></div>
}

<div class="app-main">
  <div class="main-wrap">
    @RenderBody()
  </div>
</div>

<script src="~/js/apg.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
